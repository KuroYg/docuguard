# Enable only after Supabase Auth session limits and the database migration are configured.
DOCUGUARD_AUTH_REQUIRED=false
DOCUGUARD_SUPABASE_URL=https://your-project.supabase.co
DOCUGUARD_SUPABASE_ANON_KEY=replace-with-public-anon-key
# Never put service-role keys in the frontend or this example file.
